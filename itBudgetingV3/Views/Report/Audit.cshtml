@model IEnumerable<itBudgetingV3.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Log";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-journal-text me-2"></i>Audit Log</h4>
</div>

<form method="get" asp-action="Audit" class="row g-2 mb-3">
    <div class="col-auto">
        @{
            string? entityFilter = ViewBag.EntityFilter as string;
        }
        <select name="entity" class="form-select form-select-sm">
            <option value="">All Entities</option>
            @foreach (var entityOpt in new[] { "BudgetVersion", "BudgetLine", "PurchaseRequest", "PurchaseOrder", "BudgetTransfer" })
            {
                if (entityOpt == entityFilter)
                {
                    <option value="@entityOpt" selected>@entityOpt</option>
                }
                else
                {
                    <option value="@entityOpt">@entityOpt</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
    </div>
</form>

<table class="table table-sm table-hover table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Timestamp</th>
            <th>Entity</th>
            <th>ID</th>
            <th>Action</th>
            <th>Field</th>
            <th>Old Value</th>
            <th>New Value</th>
            <th>Changed By</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td><small>@log.ChangedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                <td><span class="badge bg-secondary">@log.EntityName</span></td>
                <td>@log.EntityId</td>
                <td><span class="badge bg-primary">@log.Action</span></td>
                <td>@log.FieldName</td>
                <td><small class="text-muted">@log.OldValue</small></td>
                <td><small>@log.NewValue</small></td>
                <td><small>@log.ChangedBy</small></td>
                <td><small>@log.Notes</small></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-4">No audit entries found.</td></tr>
        }
    </tbody>
</table>
