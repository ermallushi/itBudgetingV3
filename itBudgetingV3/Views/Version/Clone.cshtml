@model itBudgetingV3.ViewModels.VersionCloneViewModel
@{
    ViewData["Title"] = "Clone Version (Forecast Revision)";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2><i class="bi bi-copy me-2"></i>Clone for Forecast Revision</h2>
        <hr/>

        <form asp-action="Clone" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="SourceVersionId" class="form-label fw-bold">Source Version (Approved/Active)</label>
                <select asp-for="SourceVersionId" class="form-select">
                    @foreach (var v in Model.AvailableVersions)
                    {
                        <option value="@v.Id">@v.Name (@v.Year) - @v.Status</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="RevisionType" class="form-label fw-bold">Revision Type</label>
                <select asp-for="RevisionType" class="form-select"
                        asp-items="Html.GetEnumSelectList<itBudgetingV3.Models.RevisionType>()">
                </select>
                <div class="form-text">
                    Closed months will retain original values. Open months start from 0.
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-copy me-1"></i>Clone
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
