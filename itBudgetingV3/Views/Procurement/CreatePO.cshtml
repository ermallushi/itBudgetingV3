@model itBudgetingV3.ViewModels.POCreateViewModel
@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h4><i class="bi bi-file-earmark-text me-2"></i>Create Purchase Order</h4>
        <p class="text-muted">@Model.PRInfo</p>
        <hr/>

        <form asp-action="CreatePO" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PurchaseRequestId" />
            <input type="hidden" asp-for="PO.PurchaseRequestId" value="@Model.PurchaseRequestId" />

            <div class="mb-3">
                <label asp-for="PO.PONumber" class="form-label fw-bold">PO Number</label>
                <input asp-for="PO.PONumber" class="form-control" placeholder="e.g. PO-2026-001" required />
            </div>
            <div class="mb-3">
                <label asp-for="PO.Description" class="form-label fw-bold">Description</label>
                <textarea asp-for="PO.Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="PO.ApprovedAmount" class="form-label fw-bold">Approved Amount (€)</label>
                <input asp-for="PO.ApprovedAmount" class="form-control" type="number" step="0.01" min="0" required />
            </div>
            <div class="mb-3">
                <label asp-for="PO.SharePointUrl" class="form-label fw-bold">SharePoint URL</label>
                <input asp-for="PO.SharePointUrl" class="form-control" type="url" placeholder="https://..." />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Create PO</button>
                <a asp-action="POs" asp-route-prId="@Model.PurchaseRequestId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
